# ============================================================
# Configuration n8n + Video Variants
# Copier en .env et renseigner les valeurs
# ============================================================

# --- n8n ---
N8N_ENCRYPTION_KEY=change-moi-un-truc-random-long
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/

# --- Postgres (n8n database) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=n8n

# --- OpenAI (optionnel, pour d'autres workflows) ---
OPENAI_API_KEY=sk-...

# --- Google Drive (configuré dans n8n UI, pas ici) ---
# Les credentials Google Drive se configurent dans n8n → Settings → Credentials

# --- ElevenLabs (optionnel, Modèle B premium) ---
# ELEVENLABS_API_KEY=...
